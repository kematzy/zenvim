  "Cypress - Page Test Template - Cypress - (JavaScript)": {
    "prefix": "cypage",
    "body": [
      "describe('PAGE: ${1:Login}', () => {",
      "  describe('GET /${2:login}', () => {",
      "    beforeEach(() => {",
      "      cy.refreshDatabase()",
      "      cy.seed()",
      "    })",
      "    ",
      "    describe('HTML Output', () => {",
      "      beforeEach(() => {",
      "        // cy.seed()",
      "        cy.visit('/${2}')",
      "      })",
      "      ",
      "      // cyseo${0}",
      "      ",
      "    })",
      "    // /HTML Output",
      "    ",
      "    describe('Functionality', () => {",
      "      beforeEach(() => {",
      "        // cy.seed()",
      "        // cy.visit('/${2}')",
      "      })",
      "      ",
      "      describe('when logged out', () => {",
      "        beforeEach(() => {",
      "          cy.visit('/${2}')",
      "        })",
      "        ",
      "        it.skip('should have some tests', () => {})",
      "      })",
      "      // /logged out",
      "      ",
      "      describe.skip('when logged in', () => {",
      "        beforeEach(() => {",
      "          cy.login()",
      "          cy.visit('/${2}')",
      "        })",
      "        ",
      "        it.skip('should have some tests', () => {})",
      "      })",
      "      // /logged in",
      "      ",
      "    })",
      "    // /Functionality",
      "  })",
      "  // /GET /${2}",
      "})",
      ""
    ],
    "description": "Page Test Template - Cypress - (JavaScript)"
  },

