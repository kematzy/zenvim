{
  "File Start Full": {
    "prefix": "fdoc",
    "body": [
      "// * begin: ${ZED_DIRECTORY/([^\\/]*\\/){2}(.*)/$2/}/${ZED_FILENAME} */",
      "",
      "$0",
      "",
      "// * /end: ${ZED_DIRECTORY/([^\\/]*\\/){2}(.*)/$2/}/${ZED_FILENAME} */",
      ""
    ],
    "description": "File document comment with name & location (SCSS)"
  },
  "import file - SCSS - (CSS)": {
    "scope": "scss",
    "prefix": "-ci",
    "body": ["@import \"${1:_variables}.scss\";"],
    "description": "Imports .scss file into SCSS file - (CSS)"
  },
  "$zen-variable - SCSS - (CSS)": {
    "scope": "scss",
    "prefix": "-$v",
    "body": ["\\$zen-${1:variable}: ${2:content}${3: !default};"],
    "description": "Adds a SCSS prefixed variable - SCSS - (CSS)"
  }
}
